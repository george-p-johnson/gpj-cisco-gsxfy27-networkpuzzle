# Copy this file to .env and adjust if needed.

# Port the web page/WebSocket server listens on.
# Must NOT be 9000 -- that port is reserved for the ESP32 boards' OSC telemetry to TouchDesigner.
HTTP_PORT=8080

# Where TouchDesigner is running. Since this server runs on the same PC as
# TouchDesigner, loopback is correct -- only change this if you move the two apart.
TD_HOST=127.0.0.1

# UDP port this server SENDS OSC commands to (TouchDesigner's OSC In DAT/CHOP must listen here).
TD_OSC_SEND_PORT=9001

# UDP port this server LISTENS on for a heartbeat OSC message FROM TouchDesigner
# (used to drive the Connected/Disconnected indicator).
TD_OSC_LISTEN_PORT=9002

# How long (ms) without a heartbeat before the UI flips to "Disconnected".
HEARTBEAT_TIMEOUT_MS=3000

# Delay (ms) between each /remote/player/<n> OSC send when Reset Game
# activates multiple players at once. TD processes incoming OSC on its own
# frame cadence, so firing several packets back-to-back with no gap can get
# some of them coalesced/dropped. Raise this if TD is still missing some.
PLAYER_ACTIVATE_STAGGER_MS=150

# Hostname that unlocks the private admin status page (per-socket resistor
# readings, see public-admin/). Any request whose Host header does NOT match
# this exactly gets the normal public control page instead -- the admin
# directory is never served on any other hostname, so there's no path to
# guess. Must have its own Cloudflare Tunnel ingress rule + DNS route
# pointing at this same server; see DEPLOYMENT.md.
ADMIN_HOSTNAME=admin.gsxnetworkpuzzle.com
